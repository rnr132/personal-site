---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const dateFormat = new Intl.DateTimeFormat('en-US', { month: 'short', year: 'numeric' });
---

<Layout title="Articles · Rohit Nair">
	<section class="reveal px-6 py-16 max-w-5xl mx-auto">
		<h1 class="font-display text-3xl font-extrabold mb-2">Articles</h1>
		<p class="text-gray-600 mb-10">Writing on corporate credit risk, and applying AI to it.</p>
		<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
			{articles.map((article) => (
				<a href={`/articles/${article.id}`} class="group rounded-2xl border p-5 transition-all hover:-translate-y-1 hover:border-teal-700 hover:shadow-lg">
					<p class="text-xs text-gray-400 mb-2">{dateFormat.format(article.data.date)} · {article.data.tag}</p>
					<h2 class="font-display font-bold mb-2 group-hover:text-teal-700">{article.data.title}</h2>
					<p class="text-sm text-gray-600">{article.data.description}</p>
				</a>
			))}
		</div>
	</section>
</Layout>
