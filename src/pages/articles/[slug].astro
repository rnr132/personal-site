---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
	const articles = await getCollection('articles');
	return articles.map((article) => ({
		params: { slug: article.id },
		props: { article },
	}));
}

const { article } = Astro.props;
const { Content } = await render(article);

const dateFormat = new Intl.DateTimeFormat('en-US', { month: 'short', year: 'numeric' });
---

<Layout title={`${article.data.title} · Rohit Nair`} description={article.data.description}>
		<article class="reveal px-6 py-16 max-w-2xl mx-auto">
			<a href="/articles" class="text-sm text-teal-700 mb-8 inline-block">← All articles</a>
			<p class="text-xs text-gray-400 mb-2">{dateFormat.format(article.data.date)} · {article.data.tag}</p>
			<h1 class="font-display text-3xl font-extrabold mb-8">{article.data.title}</h1>
			<div class="prose prose-teal max-w-none">
				<Content />
			</div>
		</article>
</Layout>
