---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { ElectricBackdrop } from '../components/ui/electric-backdrop';
import { Mail } from 'lucide-react';

const articles = (await getCollection('articles'))
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.slice(0, 3);

const experiments = (await getCollection('experiments'))
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.slice(0, 2);

const dateFormat = new Intl.DateTimeFormat('en-US', { month: 'short', year: 'numeric' });
---

<Layout>
	<section class="relative overflow-hidden">
		<ElectricBackdrop client:load />
		<div class="relative flex flex-col items-center text-center px-6 py-28 md:py-36 max-w-3xl mx-auto">
			<h1 class="font-display text-5xl sm:text-6xl md:text-7xl font-extrabold tracking-tight leading-[1.05] mb-6">
				<span class="text-teal-700">Corporate credit risk,</span><br />
				<span class="bg-gradient-to-r from-violet-600 to-teal-600 bg-clip-text text-transparent">meet AI.</span>
			</h1>
			<p class="text-lg text-gray-600 max-w-xl mb-8">
				I've spent over a decade assessing credit risk for corporates across Europe —
				from telecoms to oil & gas to metals & mining. These days, I'm also teaching
				myself AI, and this site is where I share both.
			</p>
			<div class="flex gap-4">
				<a href="/articles" class="px-5 py-2.5 rounded-full bg-teal-700 text-white font-medium hover:bg-teal-800 transition-colors">
					Read Articles
				</a>
				<a href="/about" class="px-5 py-2.5 rounded-full border border-teal-700 text-teal-700 font-medium hover:bg-teal-50 transition-colors">
					About
				</a>
			</div>
		</div>
	</section>

	<div class="reveal px-6 py-16 max-w-5xl mx-auto">
		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
			<div class="lg:col-span-2 rounded-2xl border bg-gradient-to-br from-teal-50 to-white p-6">
				<p class="font-display text-4xl font-extrabold text-teal-700">10+ yrs</p>
				<p class="mt-2 text-sm text-gray-600">Director, Scope Ratings — corporate credit risk across Europe.</p>
			</div>
			<div class="rounded-2xl border bg-white p-6">
				<p class="text-xs font-semibold uppercase tracking-wide text-gray-400 mb-2">Sectors</p>
				<p class="text-sm font-medium text-gray-800">Telecoms · Oil & Gas · Metals & Mining</p>
			</div>
			<div class="rounded-2xl border bg-gradient-to-br from-violet-50 to-white p-6">
				<p class="text-xs font-semibold uppercase tracking-wide text-violet-500 mb-2">Right now</p>
				<p class="text-sm font-medium text-gray-800">Teaching myself AI, hands-on.</p>
			</div>
			<div class="sm:col-span-2 lg:col-span-4 rounded-2xl bg-gradient-to-r from-teal-700 to-violet-700 p-6 text-white flex flex-wrap items-center justify-between gap-4">
				<p class="font-display text-xl font-bold">Say hello</p>
				<div class="flex gap-5 text-sm">
					<a href="mailto:rnair13.ai.one@gmail.com" class="flex items-center gap-1.5 opacity-90 hover:opacity-100">
						<Mail className="size-4" aria-hidden="true" />
						Email
					</a>
					<a
						href="https://www.linkedin.com/in/rohitnair13/"
						target="_blank"
						rel="noopener noreferrer"
						class="flex items-center gap-1.5 opacity-90 hover:opacity-100"
					>
						<svg viewBox="0 0 448 512" class="size-4" fill="currentColor" aria-hidden="true">
							<path d="M100.3 448l-92.9 0 0-299.1 92.9 0 0 299.1zM53.8 108.1C24.1 108.1 0 83.5 0 53.8 0 39.5 5.7 25.9 15.8 15.8s23.8-15.8 38-15.8 27.9 5.7 38 15.8 15.8 23.8 15.8 38c0 29.7-24.1 54.3-53.8 54.3zM447.9 448l-92.7 0 0-145.6c0-34.7-.7-79.2-48.3-79.2-48.3 0-55.7 37.7-55.7 76.7l0 148.1-92.8 0 0-299.1 89.1 0 0 40.8 1.3 0c12.4-23.5 42.7-48.3 87.9-48.3 94 0 111.3 61.9 111.3 142.3l0 164.3-.1 0z" />
						</svg>
						LinkedIn
					</a>
				</div>
			</div>
		</div>
	</div>

	<div class="reveal px-6 py-16 max-w-5xl mx-auto">
		<div class="flex justify-between items-center mb-8">
			<h2 class="font-display text-2xl font-bold">Featured Articles</h2>
			<a href="/articles" class="text-teal-700 text-sm font-medium">View all →</a>
		</div>
		<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
			{articles.map((article) => (
				<a href={`/articles/${article.id}`} class="group rounded-2xl border p-5 transition-all hover:-translate-y-1 hover:border-teal-700 hover:shadow-lg">
					<p class="text-xs text-gray-400 mb-2">{dateFormat.format(article.data.date)} · {article.data.tag}</p>
					<h3 class="font-display font-bold mb-2 group-hover:text-teal-700">{article.data.title}</h3>
					<p class="text-sm text-gray-600">{article.data.description}</p>
				</a>
			))}
		</div>
	</div>

	<div class="reveal px-6 py-16 max-w-5xl mx-auto">
		<div class="flex justify-between items-center mb-8">
			<h2 class="font-display text-2xl font-bold">Featured AI Experiments</h2>
			<a href="/experiments" class="text-teal-700 text-sm font-medium">View all →</a>
		</div>
		<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
			{experiments.map((experiment) => (
				<a href={`/experiments/${experiment.id}`} class="group rounded-2xl border p-5 transition-all hover:-translate-y-1 hover:border-violet-600 hover:shadow-lg">
					<p class="text-xs text-gray-400 mb-2">{dateFormat.format(experiment.data.date)}</p>
					<h3 class="font-display font-bold mb-2 group-hover:text-violet-700">{experiment.data.title}</h3>
					<p class="text-sm text-gray-600">{experiment.data.description}</p>
				</a>
			))}
		</div>
	</div>
</Layout>
