---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles'))
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.slice(0, 3);

const experiments = (await getCollection('experiments'))
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.slice(0, 2);

const dateFormat = new Intl.DateTimeFormat('en-US', { month: 'short', year: 'numeric' });
---

<Layout>
	<section class="flex flex-col items-center text-center px-6 py-24 max-w-2xl mx-auto">
		<h1 class="text-4xl font-bold text-teal-700 mb-4">
			Corporate credit risk, meet AI
		</h1>
		<p class="text-lg text-gray-600 max-w-xl mb-6">
			I've spent over a decade assessing credit risk for corporates across Europe —
			from telecoms to oil & gas to metals & mining. These days, I'm also teaching
			myself AI, and this site is where I share both.
		</p>
		<div class="flex gap-4 mt-2">
			<a href="/articles" class="px-5 py-2 rounded bg-teal-700 text-white font-medium">
				Read Articles
			</a>
			<a href="/about" class="px-5 py-2 rounded border border-teal-700 text-teal-700 font-medium">
				About
			</a>
		</div>
	</section>
	<section class="flex flex-wrap justify-center items-center gap-2 text-sm text-gray-500 border-t border-b py-6 px-6">
	<span>Director, Scope Ratings</span>
	<span>·</span>
	<span>10+ years in corporate credit risk</span>
	<span>·</span>
	<span>Telecoms · Oil & Gas · Metals & Mining</span>
	</section>
	<section class="px-6 py-16 max-w-5xl mx-auto">
	<div class="flex justify-between items-center mb-8">
		<h2 class="text-2xl font-bold">Featured Articles</h2>
		<a href="/articles" class="text-teal-700 text-sm font-medium">View all →</a>
	</div>
	<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
		{articles.map((article) => (
			<a href={`/articles/${article.id}`} class="border rounded p-5 hover:border-teal-700">
				<p class="text-xs text-gray-400 mb-2">{dateFormat.format(article.data.date)} · {article.data.tag}</p>
				<h3 class="font-semibold mb-2">{article.data.title}</h3>
				<p class="text-sm text-gray-600">{article.data.description}</p>
			</a>
		))}
	</div>
</section>
<section class="px-6 py-16 max-w-5xl mx-auto">
	<div class="flex justify-between items-center mb-8">
		<h2 class="text-2xl font-bold">Featured AI Experiments</h2>
		<a href="/experiments" class="text-teal-700 text-sm font-medium">View all →</a>
	</div>
	<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
		{experiments.map((experiment) => (
			<a href={`/experiments/${experiment.id}`} class="border rounded p-5 hover:border-teal-700">
				<p class="text-xs text-gray-400 mb-2">{dateFormat.format(experiment.data.date)}</p>
				<h3 class="font-semibold mb-2">{experiment.data.title}</h3>
				<p class="text-sm text-gray-600">{experiment.data.description}</p>
			</a>
		))}
	</div>
</section>
</Layout>
