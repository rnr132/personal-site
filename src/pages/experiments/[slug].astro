---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
	const experiments = await getCollection('experiments');
	return experiments.map((experiment) => ({
		params: { slug: experiment.id },
		props: { experiment },
	}));
}

const { experiment } = Astro.props;
const { Content } = await render(experiment);

const dateFormat = new Intl.DateTimeFormat('en-US', { month: 'short', year: 'numeric' });
---

<Layout title={`${experiment.data.title} · Rohit Nair`} description={experiment.data.description}>
		<article class="reveal px-6 py-16 max-w-2xl mx-auto">
			<a href="/experiments" class="text-sm text-teal-700 mb-8 inline-block">← All experiments</a>
			<p class="text-xs text-gray-400 mb-2">{dateFormat.format(experiment.data.date)}</p>
			<h1 class="font-display text-3xl font-extrabold mb-8">{experiment.data.title}</h1>
			<div class="prose prose-teal max-w-none">
				<Content />
			</div>
		</article>
</Layout>
