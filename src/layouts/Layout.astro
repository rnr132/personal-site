---
import '../styles/global.css';
import { SiteHeader } from '../components/ui/site-header';
import { Mail } from 'lucide-react';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Rohit Nair — Credit risk, meet AI',
	description = 'Director at Scope Ratings writing on corporate credit risk across Europe, and teaching himself AI along the way.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL('/og-image.png', Astro.site);
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="theme-color" content="#0f766e" />

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="canonical" href={canonicalURL} />

		<title>{title}</title>
		<meta name="description" content={description} />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Rohit Nair" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={ogImageURL} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />
	</head>
	<body>
		<div class="grain-overlay"></div>
		<SiteHeader client:load currentPath={Astro.url.pathname} />
		<slot />
		<footer class="border-t px-6 py-10 max-w-5xl mx-auto flex flex-col md:flex-row justify-between items-center gap-4 text-sm text-gray-500">
			<p>© 2026 Rohit Nair. Built with Astro.</p>
			<div class="flex gap-5">
				<a href="mailto:rnair13.ai.one@gmail.com" class="flex items-center gap-1.5 hover:text-teal-700">
					<Mail className="size-4" aria-hidden="true" />
					Email
				</a>
				<a
					href="https://www.linkedin.com/in/rohitnair13/"
					target="_blank"
					rel="noopener noreferrer"
					class="flex items-center gap-1.5 hover:text-teal-700"
				>
					<svg viewBox="0 0 448 512" class="size-4" fill="currentColor" aria-hidden="true">
						<path d="M100.3 448l-92.9 0 0-299.1 92.9 0 0 299.1zM53.8 108.1C24.1 108.1 0 83.5 0 53.8 0 39.5 5.7 25.9 15.8 15.8s23.8-15.8 38-15.8 27.9 5.7 38 15.8 15.8 23.8 15.8 38c0 29.7-24.1 54.3-53.8 54.3zM447.9 448l-92.7 0 0-145.6c0-34.7-.7-79.2-48.3-79.2-48.3 0-55.7 37.7-55.7 76.7l0 148.1-92.8 0 0-299.1 89.1 0 0 40.8 1.3 0c12.4-23.5 42.7-48.3 87.9-48.3 94 0 111.3 61.9 111.3 142.3l0 164.3-.1 0z" />
					</svg>
					LinkedIn
				</a>
			</div>
		</footer>
	</body>
</html>
